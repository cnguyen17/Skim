# Copy to .env.local and fill in (never commit .env.local).
# Env vars override site.config.ts — useful for deploy secrets on Cloudflare Pages.

# Cal.com username only (e.g. "skim" → cal.com/skim)
VITE_CALCOM_USER=

# Web3Forms access key from https://web3forms.com
VITE_WEB3FORMS_KEY=

# --- Gallery sync (build-time only; set these in Cloudflare Pages env vars) ---
# The Google Drive folder that skim uploads set photos to.
DRIVE_FOLDER_ID=19GlEdbPxCmU6ktLdwqom63J_Qkd1zPj7
# ONE of the following auth methods:
#   Service account (recommended — folder stays private, shared read-only with
#   the service account email). Paste the key JSON, or its base64, on one line.
GOOGLE_SERVICE_ACCOUNT_JSON=
#   OR an API key (simpler, but requires the folder to be "anyone with the link".)
GOOGLE_API_KEY=
