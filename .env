# Copy to .env.local and fill in (never commit .env.local).
# Env vars override site.config.ts — useful for deploy secrets on Cloudflare Pages.

# Cal.com username only (e.g. "skim" → cal.com/skim)
VITE_CALCOM_USER=skimproductionent

# Web3Forms access key from https://web3forms.com
VITE_WEB3FORMS_KEY=24a6ac16-85d1-4c7a-849e-864dbd5c759d

# --- Gallery sync ---
# The Drive service-account key is a SECRET and must NOT live in this tracked
# file. It is set in .env.local (git-ignored) for local runs, and in the
# Cloudflare Pages dashboard env vars for deploys. See README "Updating gallery
# photos". Do not paste GOOGLE_SERVICE_ACCOUNT_JSON here.
